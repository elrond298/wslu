#!/bin/bash
cat >/dev/null
printf 'reg.exe %s\n' "$*" >> "${WSLU_TEST_LOG:?}"
case "$*" in
  *CurrentBuild*) printf '\n    CurrentBuild    REG_SZ    22631\n\n' ;;
  *DistributionName*) printf 'HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss\\test\n    DistributionName    REG_SZ    %s\n' "${WSL_DISTRO_NAME:-TestDistro}" ;;
  *' /v Flags'*) printf '\n    Flags    REG_DWORD    0x8\n\n' ;;
  *PackageFamilyName*) exit 1 ;;
  *OEMCP*) printf '\nHKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Nls\\CodePage\n    OEMCP    REG_SZ    65001\n' ;;
  *ZoneMap*)
    case "$*" in
      *'/t REG_DWORD'*) printf 'The operation completed successfully.\n' ;;
      *wsl.localhost*)
        if [ "${WSLU_TEST_ZONE_SET:-0}" = "1" ]; then
          printf '\nHKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\wsl.localhost\n    file    REG_DWORD    0x1\n\n'
        else
          printf 'ERROR: The system was unable to find the specified registry key or value.\n' >&2
          exit 1
        fi ;;
      *"wsl$"*)
        if [ "${WSLU_TEST_ZONE_SET:-0}" = "1" ]; then
          printf '\nHKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\wsl$\n    file    REG_DWORD    0x1\n\n'
        else
          printf 'ERROR: The system was unable to find the specified registry key or value.\n' >&2
          exit 1
        fi ;;
      *) printf 'unexpected ZoneMap reg.exe call: %s\n' "$*" >&2; exit 97 ;;
    esac ;;
  *) printf 'unexpected reg.exe call: %s\n' "$*" >&2; exit 97 ;;
esac
